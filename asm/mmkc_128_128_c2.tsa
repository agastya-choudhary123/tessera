; k-chunked two-level-blocked matmul: Kc=128 Jc=128 tiles/panel=4 unroll=4
; scratchpad  B=65536  A(4 panels)=32768  C(2x)=32768  total=131072/131072B
.args 6
  arg r0, 0        ; A
  arg r1, 1        ; B
  arg r2, 2        ; C
  arg r3, 3        ; M
  arg r4, 4        ; N
  arg r5, 5        ; K
  muli r8, r5, 4   ; lda = K*4  (also the kc byte-offset bound)
  muli r9, r4, 4   ; ldb = ldc
  movi r7, 0       ; j
j_loop:
  movi r5, 0       ; kc byte offset (r5's K value is dead after lda)
  ; ========== k-chunk block (overwrite) ==========
  shri r14, r5, 2         ; kc (elements)
  mul  r14, r14, r9
  add  r14, r14, r1
  shli r15, r7, 2
  add  r14, r14, r15
  dma.in spm[0], r14, r9, 128, 512, t6     ; B[kc:kc+128, j:j+128] resident
  movi r15, 0
  mul  r14, r15, r8
  add  r14, r14, r0
  add  r14, r14, r5
  dma.in spm[65536], r14, r8, 16, 512, t0, pack16
  muli r15, r8, 16
  add  r15, r14, r15
  dma.in spm[73728], r15, r8, 16, 512, t1, pack16
  wait 64
  movi r6, 0       ; i
i_loop_first:
  ; ---- half 0 ----
  addi r15, r6, 32
  cmplt r14, r15, r3
  mul  r15, r15, r14      ; clamp tail prefetch to row-block 0
  mul  r14, r15, r8
  add  r14, r14, r0
  add  r14, r14, r5
  dma.in spm[81920], r14, r8, 16, 512, t2, pack16
  muli r15, r8, 16
  add  r15, r14, r15
  dma.in spm[90112], r15, r8, 16, 512, t3, pack16
  wait 3
  wait 16          ; C staging 0 free
  zerza za0
  zerza za1
  zerza za2
  zerza za3
  movi r10, 65536
  movi r11, 73728
  movi r12, 0
  movi r13, 73728
k_first_0_0:
  ldv  v0,   spm[0+r10]
  ldv  v1, spm[0+r11]
